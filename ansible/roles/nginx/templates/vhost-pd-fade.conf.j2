# pd-fade: static SPA + API reverse proxy (SSE-friendly events endpoint).
# Origin is HTTP-only; HTTPS is terminated at Cloudflare.

server {
    listen 80;
    server_name {{ root_domain }};

    root {{ pd_fade_current_link }}/client/dist;
    index index.html;

    set $forwarded_proto $scheme;
    if ($http_x_forwarded_proto != "") {
        set $forwarded_proto $http_x_forwarded_proto;
    }

    location ~ ^/api/session/[^/]+/events$ {
        rewrite ^/api/(.*) /$1 break;
        proxy_pass http://127.0.0.1:{{ pd_fade_server_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout {{ pd_fade_sse_proxy_read_timeout }};
    }

    location /api/ {
        rewrite ^/api/(.*) /$1 break;
        proxy_pass http://127.0.0.1:{{ pd_fade_server_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
